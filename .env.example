# Copy to .env and adjust: `cp .env.example .env`. .env is ignored by Git and
# never copied into an image. docker compose reads it automatically.

# ---- Required on a server -------------------------------------------------
# The name people type to reach NeoStay: no https://, no path. Requests for
# any other name are refused. Separate several names with commas.
NEOSTAY_TRUSTED_HOSTS=neostay.hospital.local

# ---- HTTPS ----------------------------------------------------------------
# With the bundled proxy (docker compose --profile https up -d --build):
NEOSTAY_SITE_ADDRESS=neostay.hospital.local
# "internal" gives a certificate from Caddy's own authority (IT must trust its
# root certificate). With the hospital's certificate in deploy/certs/, use:
# NEOSTAY_TLS=/certs/neostay.crt /certs/neostay.key
NEOSTAY_TLS=internal

# Without the bundled proxy, NeoStay listens here for the hospital's own proxy.
# NEOSTAY_BIND_ADDRESS=127.0.0.1
# NEOSTAY_PORT=8000
# Proxies allowed to report the client address and scheme (comma-separated IPs).
# NEOSTAY_FORWARDED_ALLOW_IPS=*

# ---- Sign-in ---------------------------------------------------------------
# How long a sign-in lasts, in hours.
# NEOSTAY_SESSION_HOURS=12

# Hospital single sign-on instead of NeoStay passwords, through an identity-aware
# reverse proxy. The proxy must strip these headers from incoming requests and
# set them itself; mount the secret as a file (see docs/DEPLOYMENT.md).
# NEOSTAY_AUTH_MODE=proxy
# NEOSTAY_AUTH_USER_HEADER=X-Forwarded-User
# NEOSTAY_PROXY_SECRET_FILE=/run/secrets/neostay_proxy_secret

# ---- Local development only ------------------------------------------------
# NEOSTAY_ENV=development
# NEOSTAY_EXPOSE_DOCS=true
